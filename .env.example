# 이 파일을 .env.local 로 복사한 뒤 실제 값을 입력하세요. .env.local 은 커밋하지 않습니다.

# Notion 통합(Integration)의 시크릿. 서버 전용이므로 NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
NOTION_API_KEY=

# Projects Database 의 data source ID (최신 API 는 database_id 가 아닌 data_source_id 를 받습니다)
NOTION_PROJECTS_DATA_SOURCE_ID=

# (선택) 온디맨드 재검증용 시크릿. Notion 자동화 웹훅이 POST /api/revalidate 를 호출할 때
# Authorization: Bearer <값> 으로 보낸다. 비워 두면 해당 엔드포인트는 503 으로 닫힌다.
# 생성 예: openssl rand -hex 32
NOTION_REVALIDATE_SECRET=
